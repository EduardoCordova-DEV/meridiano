{
  "name": "meridiano-desk-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Relojes mundiales privados para Windows, con Ciudad de Mexico como referencia.",
  "productName": "Meridiano Desk App",
  "author": "Meridiano",
  "main": "electron-dist/main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "npm run build:electron && npm run icons && node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5183 --strictPort",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build && npm run build:electron && npm run icons",
    "icons": "node scripts/generate-icons.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4183 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:packaged": "playwright test --config playwright.electron.config.ts --project packaged",
    "pack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "jsdom": "^26.1.0",
    "sharp": "0.35.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.0"
  }
}
